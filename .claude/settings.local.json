{
  "permissions": {
    "allow": [
      "Bash(tree:*)",
      "Bash(find:*)",
      "Bash(npm install:*)",
      "Bash(npm run build:*)",
      "Bash(ls:*)",
      "Bash(brew list:*)",
      "Bash(supabase init:*)",
      "Bash(supabase link:*)",
      "Bash(supabase db push:*)",
      "Bash(supabase db lint:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npm run lint:*)",
      "Bash(supabase --version:*)",
      "Bash(supabase migration:*)",
      "Bash(npx supabase:*)",
      "Bash(grep:*)",
      "Bash(xargs ls:*)",
      "Bash(curl:*)",
      "Bash(git checkout:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "WebFetch(domain:chakra-ui.com)",
      "mcp__ide__getDiagnostics"
    ],
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/secrets/*)",
      "Read(**/*credential*)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
